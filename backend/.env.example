NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# MySQL (see docker-compose.yml — `docker compose up -d` starts a matching local instance)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sitiket
DB_USER=sitiket
DB_PASSWORD=sitiket_dev_password
DB_ROOT_PASSWORD=sitiket_root_password

# Session auth: backend verifies a Google ID token, then issues its own JWT.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# HMAC key used to sign each ticket's QR payload (separate from JWT_SECRET so QR tokens don't share a key with session auth).
QR_SIGNING_SECRET=

# Local disk storage for event images and payment-proof uploads in development.
UPLOAD_DIR=uploads

# Checkout timing
ORDER_PAYMENT_HOLD_MINUTES=10
MERCH_PAYMENT_HOLD_HOURS=24

# Optional: enables embedding-based semantic merch search (Voyage AI).
# Unset, catalog search falls back to FULLTEXT + fuzzy matching.
VOYAGE_API_KEY=
GUEST_EMAIL_OTP_TTL_MINUTES=10

# Platform SMTP — used only for platform emails (super-admin/organizer-application
# notifications). Buyer-facing email (OTP, tickets, refunds) is sent through each
# event organizer's own SMTP config (dashboard → Email settings, stored in the
# organizer_email_configs table). Leave SMTP_HOST blank to skip platform sends —
# the guest OTP then just logs server-side in development.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional dedicated key (min 16 chars) for encrypting organizer SMTP passwords
# at rest. Falls back to a JWT_SECRET-derived key when unset — set it in
# production so rotating JWT_SECRET doesn't invalidate stored SMTP passwords.
EMAIL_CONFIG_SECRET=

# Alternative to VOYAGE_API_KEY: any OpenAI-compatible /embeddings endpoint
# (OpenAI, DeepInfra, ...). All three must be set together; they take
# precedence over VOYAGE_API_KEY. EMBEDDINGS_MODEL must be an embedding
# model — chat models (e.g. deepseek-chat) cannot produce embeddings.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Optional: cosine-similarity cutoff override for semantic candidates
# (defaults: 0.45 for Voyage, 0.35 for OpenAI-compatible).
EMBEDDINGS_MIN_SIMILARITY=
